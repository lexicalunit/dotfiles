[submodule ".tufte-pandoc-css"]
	path = .tufte-pandoc-css
	url = https://github.com/jez/tufte-pandoc-css.git
	ignore = dirty
[submodule ".tufte-css"]
	path = .tufte-css
	url = https://github.com/edwardtufte/tufte-css.git
	branch = gh-pages
[submodule ".zprezto"]
	path = .zprezto
	url = https://github.com/sorin-ionescu/prezto.git
	ignore = dirty
[submodule ".config/tinted-theming/tinted-shell"]
	path = .config/tinted-theming/tinted-shell
	url = https://github.com/tinted-theming/tinted-shell.git
