#!/bin/bash

# Sets the desktop wallpaper on all screens.

usage() {
    (
        echo "usage: ${0##*/} [-h|--help] --path IMAGE"
        echo "Sets the desktop wallpaper on all screens."
        echo
        echo "options:"
        (
            echo "    -h, --help@ show usage help"
            echo "    --path IMAGE@ the path of the image"
        ) | column -ts@
    ) >&2
    exit 1
}

if echo "$*" | grep -Eq -- '--help\b|-h\b'; then
    usage
fi

IMAGE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
    --path)
        IMAGE="$2"
        shift 2 || usage
        ;;
    --path=*)
        IMAGE="${1#--path=}"
        shift
        ;;
    *) usage ;;
    esac
done

if [[ -z $IMAGE ]]; then
    echo "error: you must supply a path for the desktop picture" >&2
    usage
fi

if [[ ! -f $IMAGE ]]; then
    echo "error: no such file: $IMAGE" >&2
    exit 1
fi

IMAGE="$(cd "$(dirname "$IMAGE")" && pwd)/$(basename "$IMAGE")"

# The first run will ask for permission to let your terminal control System Events.
osascript - "$IMAGE" <<'EOF'
on run argv
    tell application "System Events"
        tell every desktop
            set picture to item 1 of argv
        end tell
    end tell
end run
EOF
