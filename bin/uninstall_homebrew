#!/bin/bash

# Uninstalls Homebrew.

if echo "$*" | grep -Eq -- '--help\b|-h\b'; then
    echo "usage: ${0##*/} [-h|--help]" 1>&2
    echo "Runs the official Homebrew uninstall script, which asks for confirmation first." 1>&2
    echo "See https://github.com/Homebrew/install#uninstall-homebrew for details." 1>&2
    exit 1
fi

set -e

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)"
