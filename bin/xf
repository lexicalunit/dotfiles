#!/bin/bash

# Extract common file formats.

# Display usage if no parameters given
if [[ -z $* ]] || echo "$*" | grep -Eq -- '--help\b|-h\b'; then
    echo "usage: ${0##*/} <archive> - extract common file formats"
    exit
fi

# Only some formats need a program that might not be installed
require() {
    hash "$1" 2>/dev/null ||
        {
            echo >&2 " Required program \"$1\" not installed."
            exit 1
        }
}

# Test if file exists
if [ ! -f "$*" ]; then
    echo "File $* doesn't exist"
    exit
fi

# Extract file by using extension as reference
case "$@" in
# *.7z      ) 7z  x       "$@"                ;;
*.tar.bz2) tar xvjf "$@" ;;
*.bz2) bunzip2 "$@" ;;
*.deb) ar vx "$@" ;;
*.tar.gz) tar xvf "$@" ;;
*.gz) gunzip "$@" ;;
*.tar) tar xvf "$@" ;;
*.tbz2) tar xvjf "$@" ;;
*.tar.xz) tar xvf "$@" ;;
*.tgz) tar xvzf "$@" ;;
*.rar) require unrar && unrar x "$@" ;;
# *.rar     ) 7z  x       "$@"                ;;
*.zip) require unzip && unzip "$@" ;;
*.Z) uncompress "$@" ;;
*) echo " Unsupported file format" ;;
esac
